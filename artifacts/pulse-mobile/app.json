{
  "expo": {
    "name": "Pulse",
    "slug": "pulse-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pulse-mobile",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": ["expo-router", ["expo-image-picker", { "photosPermission": "Choose a meal photo to analyze.", "cameraPermission": "Take a meal photo to analyze." }], ["expo-camera", { "cameraPermission": "Allow Pulse to scan food barcodes." }]],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
